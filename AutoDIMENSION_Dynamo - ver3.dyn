    },
    {
      "ConcreteType": "DSRevitNodesUI.Categories, DSRevitNodesUI",
      "SelectedIndex": 522,
      "SelectedString": "OST_Walls",
      "Id": "f12f6e83f8f34bbebed01b53b47b0719",
      "NodeType": "ExtensionNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "4cf969375aee4b7d91491546cd473fbd",
          "Name": "Category",
          "Description": "The selected Category.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Todas as categorias incorporadas."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitServices\")\r\n\r\nimport Autodesk.Revit.DB as DB\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\n# Inicialização do documento e vista ativa\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nview = doc.ActiveView\r\n\r\n# Tratamento dos inputs do Dynamo\r\nraw = IN[2] if isinstance(IN[2], list) else [IN[2]]\r\nelementos = [el.InternalElement if hasattr(el, \"InternalElement\") else el \r\n             for el in raw if el is not None]\r\n\r\n# Configuração de distanciamento das cotas (em mm para pés)\r\noffset_mm = float(IN[3]) if IN[3] is not None else 600.0\r\noff = offset_mm / 304.8\r\ndist_entre_linhas = 400.0 / 304.8 # Distância entre a cota parcial e a cota total\r\n\r\n# Filtrar apenas paredes válidas\r\nparedes = [el for el in elementos if isinstance(el, DB.Wall) and el.Location is not None]\r\n\r\ndimensoes_criadas = []\r\nlog = []\r\n\r\ntodos_pts = []\r\nx_faces = []\r\ny_faces = []\r\n\r\n# 1. Coleta direcionada usando apenas as superfícies principais das paredes\r\nfor p in paredes:\r\n    try:\r\n        c = p.Location.Curve\r\n        if isinstance(c, DB.Line):\r\n            todos_pts.append(c.GetEndPoint(0))\r\n            todos_pts.append(c.GetEndPoint(1))\r\n            \r\n        # Coleta apenas as referências das faces externas e internas brutas\r\n        ext_refs = DB.HostObjectUtils.GetSideFaces(p, DB.ShellLayerType.Exterior)\r\n        int_refs = DB.HostObjectUtils.GetSideFaces(p, DB.ShellLayerType.Interior)\r\n        refs_parede = list(ext_refs) + list(int_refs)\r\n        \r\n        for r in refs_parede:\r\n            face = p.GetGeometryObjectFromReference(r)\r\n            if isinstance(face, DB.PlanarFace):\r\n                normal = face.FaceNormal\r\n                # Separação estrita por ortogonalidade\r\n                if abs(normal.X) > 0.99 and abs(normal.Y) < 0.01:\r\n                    x_faces.append((face.Origin.X, r))\r\n                elif abs(normal.Y) > 0.99 and abs(normal.X) < 0.01:\r\n                    y_faces.append((face.Origin.Y, r))\r\n    except Exception as e:\r\n        continue\r\n\r\nif todos_pts:\r\n    x_min = min(pt.X for pt in todos_pts)\r\n    x_max = max(pt.X for pt in todos_pts)\r\n    y_min = min(pt.Y for pt in todos_pts)\r\n    y_max = max(pt.Y for pt in todos_pts)\r\n    \r\n    try: z = view.GenLevel.Elevation\r\n    except: z = 0.0\r\n\r\n    # Função para agrupar e eliminar linhas coincidentes ou fantasmas (tol = 2cm)\r\n    def consolidar_linhas(lista_faces, tol=0.06):\r\n        if not lista_faces: return []\r\n        lista_faces.sort(key=lambda x: x[0])\r\n        filtrados = [lista_faces[0]]\r\n        for item in lista_faces[1:]:\r\n            if abs(item[0] - filtrados[-1][0]) > tol:\r\n                filtrados.append(item)\r\n        return filtrados\r\n\r\n    x_limpas = consolidar_linhas(x_faces)\r\n    y_limpas = consolidar_linhas(y_faces)\r\n\r\n    # Selecionar o tipo de cota\r\n    dim_type = None\r\n    for dt in DB.FilteredElementCollector(doc).OfClass(DB.DimensionType):\r\n        if \"alinhad\" in dt.Name.lower() or \"linear\" in dt.Name.lower():\r\n            dim_type = dt\r\n            break\r\n    if dim_type is None:\r\n        dim_type = DB.FilteredElementCollector(doc).OfClass(DB.DimensionType).FirstElement()\r\n\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n    # ==================== EIXO X (COTAS HORIZONTAIS) ====================\r\n    if len(x_limpas) >= 2:\r\n        try:\r\n            # A. Cota Parcial (Segmentada)\r\n            refs_x_parcial = DB.ReferenceArray()\r\n            for coord, ref in x_limpas: refs_x_parcial.Append(ref)\r\n            \r\n            p1_p = DB.XYZ(x_limpas[0][0], y_min - off, z)\r\n            p2_p = DB.XYZ(x_limpas[-1][0], y_min - off, z)\r\n            linha_x_p = DB.Line.CreateBound(p1_p, p2_p)\r\n            dimensoes_criadas.append(doc.Create.NewDimension(view, linha_x_p, refs_x_parcial, dim_type))\r\n            \r\n            # B. Cota Total (Apenas extremidades para limpeza visual)\r\n            refs_x_total = DB.ReferenceArray()\r\n            refs_x_total.Append(x_limpas[0][1])\r\n            refs_x_total.Append(x_limpas[-1][1])\r\n            \r\n            p1_t = DB.XYZ(x_limpas[0][0], y_min - off - dist_entre_linhas, z)\r\n            p2_t = DB.XYZ(x_limpas[-1][0], y_min - off - dist_entre_linhas, z)\r\n            linha_x_t = DB.Line.CreateBound(p1_t, p2_t)\r\n            dimensoes_criadas.append(doc.Create.NewDimension(view, linha_x_t, refs_x_total, dim_type))\r\n        except Exception as e: log.append(f\"Erro no Eixo X: {str(e)}\")\r\n\r\n    # ==================== EIXO Y (COTAS VERTICAIS) ====================\r\n    if len(y_limpas) >= 2:\r\n        try:\r\n            # A. Cota Parcial (Segmentada)\r\n            refs_y_parcial = DB.ReferenceArray()\r\n            for coord, ref in y_limpas: refs_y_parcial.Append(ref)\r\n            \r\n            p1_p = DB.XYZ(x_min - off, y_limpas[0][0], z)\r\n            p2_p = DB.XYZ(x_min - off, y_limpas[-1][0], z)\r\n            linha_y_p = DB.Line.CreateBound(p1_p, p2_p)\r\n            dimensoes_criadas.append(doc.Create.NewDimension(view, linha_y_p, refs_y_parcial, dim_type))\r\n            \r\n            # B. Cota Total (Apenas extremidades)\r\n            refs_y_total = DB.ReferenceArray()\r\n            refs_y_total.Append(y_limpas[0][1])\r\n            refs_y_total.Append(y_limpas[-1][1])\r\n            \r\n            p1_t = DB.XYZ(x_min - off - dist_entre_linhas, y_limpas[0][0], z)\r\n            p2_t = DB.XYZ(x_min - off - dist_entre_linhas, y_limpas[-1][0], z)\r\n            linha_y_t = DB.Line.CreateBound(p1_t, p2_t)\r\n            dimensoes_criadas.append(doc.Create.NewDimension(view, linha_y_t, refs_y_total, dim_type))\r\n        except Exception as e: log.append(f\"Erro no Eixo Y: {str(e)}\")\r\n\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = [dimensoes_criadas, log]",
      "Engine": "IronPython3",
      "VariableInputPorts": true,
      "Id": "a4ec57f1f23a47229ff374ec5ca6411f",
      "NodeType": "PythonScriptNode",
